    // ==================== BPM 列表 ====================

    function getNumericBpm(bpm) {
      if (typeof bpm === 'number') return bpm;
      if (typeof bpm === 'string') {
        const match = bpm.match(/^[\d.]+/);
        if (match) return parseFloat(match[0]);
      }
      return 0;
    }

    function showBpmList() {
      const bpmSet = new Set();
      chapters.forEach(ch => {
        if (!ch.songs) return;
        ch.songs.forEach(song => {
          if (song.bpm !== undefined && song.bpm !== null) bpmSet.add(String(song.bpm).trim());
        });
      });

      const bpmList = Array.from(bpmSet).sort((a, b) => {
        const numA = getNumericBpm(a);
        const numB = getNumericBpm(b);
        if (numA !== numB) return numA - numB;
        return a.localeCompare(b);
      });

      let html = `
        <a class="back-link" onclick="goHome()">← 返回主页</a>
        <h1 class="page-title">BPM 列表</h1>
        <div class="rating-grid">
      `;
      bpmList.forEach(bpm => {
        let count = 0;
        chapters.forEach(ch => {
          if (!ch.songs) return;
          ch.songs.forEach(song => { if (String(song.bpm).trim() === bpm) count++; });
        });
        const safeBpm = bpm.replace(/'/g, "\\'");
        html += `
          <button class="rating-btn" onclick="showBpmSongs('${safeBpm}')" style="font-size: 16px;">
            ${bpm} <span style="font-size: 12px; font-weight: normal; color: var(--text-dim); margin-left: 4px;">(${count})</span>
          </button>
        `;
      });
      html += `</div>`;
      app.innerHTML = html;
      window.scrollTo(0, 0);
    }

