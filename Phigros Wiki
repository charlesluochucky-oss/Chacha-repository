      `;

      diffs.forEach((d, index) => {
        const lv = d.level || "?";
        let isActive = "";
        if (index === 0 && !diffs.find(x => x.level === "IN" || x.level === "AT")) {
          isActive = "active";
        } else if (lv === "IN" || (lv === "AT" && !diffs.find(x => x.level === "IN"))) {
