    // ==================== 工具函数 ====================

    function getAllRatings(chapter) {
      const list = [];
      if (!chapter || !chapter.songs) return list;
      chapter.songs.forEach(s => {
        if (s && s.difficulties) {
          s.difficulties.forEach(d => {
            if (d && d.rating !== null && d.rating !== undefined) list.push(d.rating);
          });
        }
      });
      return list;
    }

    function getRatingsByLevel(chapter, level) {
      const list = [];
      if (!chapter || !chapter.songs) return list;
      chapter.songs.forEach(s => {
        if (s && s.difficulties) {
          s.difficulties.forEach(d => {
            if (d && d.level === level && d.rating !== null && d.rating !== undefined) {
              list.push(d.rating);
            }
          });
        }
      });
      return list;
    }

    function avg(arr) {
      if (!arr || arr.length === 0) return null;
      return arr.reduce((a, b) => a + b, 0) / arr.length;
    }

    function fmtAvg(arr) {
      const a = avg(arr);
      return a === null ? "-" : a.toFixed(3);
    }

    function chapterStats(chapter) {
      const all = getAllRatings(chapter);
      const songCount = (chapter && chapter.songs) ? chapter.songs.length : 0;
      return {
        songCount: songCount,
        min: all.length ? Math.min(...all).toFixed(1) : "-",
        max: all.length ? Math.max(...all).toFixed(1) : "-",
        avgIN: fmtAvg(getRatingsByLevel(chapter, "IN")),
        avgHD: fmtAvg(getRatingsByLevel(chapter, "HD")),
        avgEZ: fmtAvg(getRatingsByLevel(chapter, "EZ")),
        avgAT: fmtAvg(getRatingsByLevel(chapter, "AT"))
      };
    }

    function getCharters(song) {
      const set = new Set();
      if (song && song.difficulties) {
        song.difficulties.forEach(d => { if (d && d.charter) set.add(d.charter); });
      }
      return Array.from(set).join(" & ");
    }

    function ratingText(r) {
      return (r === null || r === undefined) ? "?" : (typeof r === "number" ? r.toFixed(1) : r);
    }

