    // 启动！
    goHome();
    // ==================== 全局侧边栏控制 ====================

    function toggleSideNav() {
      const panel = document.getElementById("side-nav-panel");
      const trigger = document.getElementById("side-nav-trigger");

      if (panel.classList.contains("open")) {
        panel.classList.remove("open");
        trigger.classList.remove("open");
      } else {
        panel.classList.add("open");
        trigger.classList.add("open");
      }
    }

    // 鼠标离开侧边栏时自动关闭
    document.getElementById("side-nav-panel").addEventListener("mouseleave", () => {
      const panel = document.getElementById("side-nav-panel");
      const trigger = document.getElementById("side-nav-trigger");
      panel.classList.remove("open");
      trigger.classList.remove("open");
    });

    // 监听内容变化，自动生成侧边栏
    const observer = new MutationObserver((mutations) => {
      const navContent = document.getElementById("side-nav-content");
      if (!navContent) return;

      let navHtml = "";

      // 1. 如果在 PMT 赛况页
      const roundTitles = document.querySelectorAll(".pmt-round-title");
      if (roundTitles.length > 0) {
        navHtml += `<h4>PMT 赛程</h4>`;
        roundTitles.forEach((title, idx) => {
          const anchorId = `pmt-round-${idx}`;
          title.id = anchorId;
          navHtml += `<a onclick="document.getElementById('${anchorId}').scrollIntoView({behavior: 'smooth'})">${title.innerText}</a>`;
        });
      }

      // 2. 如果在 曲目列表 页（通过判断是否有 chapter-row）
      const chapterRows = document.querySelectorAll(".chapter-row");
      const isChapterList = document.querySelector(".page-title") && document.querySelector(".page-title").innerText === "曲目列表";

      if (isChapterList && chapterRows.length > 0) {
        // 分类容器
        let cats = {
          main: [],
          side: [],
          ex: [],
          other: [],
          single: []
        };

        chapterRows.forEach((row, idx) => {
          const nameEl = row.querySelector(".chapter-name");
          const numEl = row.querySelector(".chapter-num");
          const onclickStr = row.getAttribute("onclick");

          if (nameEl && onclickStr) {
            const name = nameEl.innerText;
            const num = numEl ? numEl.innerText : "";

            let cat = "main";
            if (num.includes("Side Story")) cat = "side";
            else if (num.includes("Chapter EX")) cat = "ex";
            else if (num.includes("Other") || num.includes("Chapter Other")) cat = "other";
            else if (num.includes("SP") || num.includes("愚人节")) cat = "other";
            else if (num.includes("Single")) cat = "single";

            cats[cat].push({ name, onclickStr });
          }
        });

        // 渲染分类
        if (cats.main.length > 0) {
          navHtml += `<h4>主线章节</h4>`;
          cats.main.forEach(item => navHtml += `<a onclick="${item.onclickStr}">${item.name}</a>`);
        }
        if (cats.side.length > 0) {
          navHtml += `<h4>支线章节</h4>`;
          cats.side.forEach(item => navHtml += `<a onclick="${item.onclickStr}">${item.name}</a>`);
        }
        if (cats.ex.length > 0) {
          navHtml += `<h4>外传 / EX章节</h4>`;
          cats.ex.forEach(item => navHtml += `<a onclick="${item.onclickStr}">${item.name}</a>`);
        }
        if (cats.other.length > 0) {
          navHtml += `<h4>其他章节</h4>`;
          cats.other.forEach(item => navHtml += `<a onclick="${item.onclickStr}">${item.name}</a>`);
        }
        if (cats.single.length > 0) {
          navHtml += `<h4>单曲章节</h4>`;
          cats.single.forEach(item => navHtml += `<a onclick="${item.onclickStr}">${item.name}</a>`);
        }
      }

      // 如果有内容，显示触发器，否则隐藏
      if (navHtml) {
        navContent.innerHTML = navHtml;
        document.getElementById("side-nav-trigger").style.display = "flex";
      } else {
        document.getElementById("side-nav-trigger").style.display = "none";
        document.getElementById("side-nav-panel").classList.remove("open");
        document.getElementById("side-nav-trigger").classList.remove("open");
      }
    });

    // 监听 app 容器
    observer.observe(document.getElementById("app"), { childList: true, subtree: true });
  </script>
