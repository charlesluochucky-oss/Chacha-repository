            { groupName: "二胜一负者组", players: [{ name: "喜多郁代", id: "@没有底力的菜", score: 1997812, status: "三胜一负" }, { name: "Xtrrrffusion", id: "@Strrrffe", score: 1995555, status: "二负淘汰" }], charts: [{ title: "iL-Artifact [IN]", scores: [998358, 999218] }, { title: "Distorted Fate [AT]", scores: [999454, 996337] }] },
