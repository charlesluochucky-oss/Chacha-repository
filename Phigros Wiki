      ];

      let html = `
        <a class="back-link" onclick="goHome()">← 返回主页</a>
        <h1 class="page-title">PMT 2026 · 赛况</h1>
        <div class="pmt-bracket-container">
      `;

      bracketData.forEach((roundData, rIndex) => {
        html += `<h2 class="pmt-round-title anim-item" style="--i: ${rIndex}">${roundData.round}</h2>`;

        roundData.groups.forEach((group, gIndex) => {
          html += `
            <div class="pmt-match-card anim-item" style="--i: ${gIndex}">
              <div class="pmt-match-header">${group.groupName}</div>
              <div class="pmt-match-body">
                <!-- 选手得分区 -->
                <div class="pmt-match-players">
          `;
          group.players.forEach(p => {
            let statusClass = "";
            if (p.status.includes("晋级") || p.status.includes("冠军")) statusClass = "status-win";
            else if (p.status.includes("淘汰") || p.status.includes("亚军") || p.status.includes("季军")) statusClass = "status-lose";
            else if (p.status.includes("胜")) statusClass = "status-win";
            else if (p.status.includes("负")) statusClass = "status-lose";

            html += `
                  <div class="pmt-player-row">
                    <div class="pmt-p-info">
