    function switchDiffTab(level) {
      const tabs = document.querySelectorAll(".diff-tab");
      tabs.forEach(t => {
        if (t.getAttribute("data-level") === level) {
          t.classList.add("active");
        } else {
          t.classList.remove("active");
        }
      });

      const songTitle = document.querySelector(".song-detail-header h2").innerText;
      let currentSong = null;
      chapters.forEach(ch => {
        if (ch.songs) {
          const found = ch.songs.find(s => s.title === songTitle);
          if (found) currentSong = found;
        }
      });

      if (!currentSong) return;
      const diff = currentSong.difficulties.find(d => d.level === level);
      if (!diff) return;

      const total = diff.noteCount || 1;
      const types = [
        { name: "Tap", val: diff.tap || 0, color: "#4ea1ff" },
        { name: "Drag", val: diff.drag || 0, color: "#22c55e" },
        { name: "Hold", val: diff.hold || 0, color: "#ef4444" },
        { name: "Flick", val: diff.flick || 0, color: "#f59e0b" }
      ];

      let contentHtml = `
        <div class="total-notes">${diff.noteCount || 0} <span>Notes</span></div>
        <div class="note-bars-grid">
      `;

      types.forEach(t => {
        const pct = ((t.val / total) * 100).toFixed(1);
        contentHtml += `
          <div class="note-bar-item">
            <div class="bar-label"><span>${t.name}</span><span>${t.val} (${pct}%)</span></div>
            <div class="bar-bg"><div class="bar-fill" style="width: ${pct}%; background: ${t.color};"></div></div>
          </div>
        `;
      });

      contentHtml += `</div>`;

      const container = document.getElementById("sidebar-content");
      if (container) {
        container.innerHTML = contentHtml;
        container.style.animation = 'none';
        container.offsetHeight;
        container.style.animation = null;
      }
