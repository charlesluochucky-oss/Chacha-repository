        `;
      });
      html += `</div>`;
      app.innerHTML = html;
      window.scrollTo(0, 0);
    }

    function showCharterSongs(charterName) {
      const charterMap = getCharterData();
      const songsList = charterMap[charterName] || [];
      let html = `
        <a class="back-link" onclick="showCharterList()">← 返回谱师列表</a>
