    // ==================== 定数列表 ====================

    function showRatingList() {
      const levels = ["ALL", "EZ", "HD", "IN", "AT", "LY", "SP"];

      let html = `
        <a class="back-link" onclick="goHome()">← 返回主页</a>
        <h1 class="page-title">定数列表 · 难度选择</h1>
        <div class="chapter-list">
      `;

      levels.forEach(lv => {
        let count = 0;
        chapters.forEach(ch => {
          if (ch.songs) {
            ch.songs.forEach(song => {
              if (song.difficulties) {
                song.difficulties.forEach(d => {
                  if (lv === "ALL") {
                    if (d.rating !== null && d.rating !== undefined) count++;
                  } else if (lv === "SP") {
                    if (d.level === "SP") count++;
                  } else {
                    if (d.level === lv && d.rating !== null && d.rating !== undefined) count++;
                  }
                });
              }
            });
          }
        });

        if (count === 0) return;

        let displayName = lv === "ALL" ? "全部" : lv;
        let diffClass = lv === "ALL" ? "diff-all" : `diff-${lv.toLowerCase()}`;
        let clickAction = `showRatingDetails('${lv}')`;

        html += `
          <div class="chapter-row" onclick="${clickAction}">
            <div class="chapter-left"><div class="chapter-name ${diffClass}">${displayName}</div></div>
            <div class="chapter-stats"><span class="stat"><span class="k">谱面数量：</span><span class="v">${count}</span></span></div>
          </div>
        `;
      });
      html += `</div>`;
      app.innerHTML = html;
      window.scrollTo(0, 0);
    }

    function showRatingDetails(level) {
      if (level === "SP") {
        showRatingSongs("SP", null);
        return;
      }

      const ratingsSet = new Set();
      chapters.forEach(ch => {
        if (ch.songs) {
          ch.songs.forEach(song => {
            if (song.difficulties) {
              song.difficulties.forEach(d => {
                if (level === "ALL") {
                  if (d.rating !== null && d.rating !== undefined) ratingsSet.add(d.rating);
                } else {
                  if (d.level === level && d.rating !== null && d.rating !== undefined) ratingsSet.add(d.rating);
                }
              });
            }
          });
        }
      });

      const ratings = Array.from(ratingsSet).sort((a, b) => a - b);
      let displayLevel = level === "ALL" ? "全部" : level;
      let colorClass = level === "ALL" ? "diff-all" : `diff-${level.toLowerCase()}`;

      let html = `
        <a class="back-link" onclick="showRatingList()">← 返回难度选择</a>
        <h1 class="page-title">定数列表 · <span class="${colorClass}">${displayLevel}</span></h1>
        <div class="rating-grid">
      `;
      ratings.forEach(r => {
        const rText = typeof r === "number" ? r.toFixed(1) : r;
        html += `<button class="rating-btn" onclick="showRatingSongs('${level}', ${r})">${rText}</button>`;
      });
      html += `</div>`;
      app.innerHTML = html;
      window.scrollTo(0, 0);
    }

    function showRatingSongs(level, rating) {
      const resultSongs = [];
      chapters.forEach(ch => {
        if (ch.songs) {
          ch.songs.forEach(song => {
            if (song.difficulties) {
              const matchDiff = song.difficulties.find(d => {
                if (level === "SP") return d.level === "SP";
                if (level === "ALL") return d.rating === rating;
                return d.level === level && d.rating === rating;
              });
              if (matchDiff) resultSongs.push({ song, chapter: ch, diff: matchDiff });
            }
          });
        }
      });

      let rText = "?";
      if (typeof rating === 'number') rText = rating.toFixed(1);

      let displayLevel = level === "ALL" ? "全部" : level;
      let colorClass = level === "ALL" ? "diff-all" : `diff-${level.toLowerCase()}`;

      let backAction = level === "SP" ? "showRatingList()" : `showRatingDetails('${level}')`;

      let html = `
        <a class="back-link" onclick="${backAction}">← 返回定数选择</a>
        <h1 class="page-title"><span class="${colorClass}">${displayLevel} ${rText}</span> · 曲目列表 (${resultSongs.length})</h1>
        <div class="song-list">
      `;

      resultSongs.forEach(item => {
        const safeRating = (rating === null || rating === undefined) ? 'null' : rating;
        const songLevel = level === "ALL" ? "ALL" : level;
        const realLevel = item.diff.level || "?";

        html += `
          <div class="song-row" onclick="showSong('${item.song.id}', 'rating', '${songLevel}', ${safeRating})">
            <div class="song-row-left">
              <div class="song-row-title">${item.song.title}</div>
              <div class="song-row-charter">所属章节：${item.chapter.name} · 谱师：${item.diff.charterName || "-"}</div>
            </div>
            <div class="song-row-diffs">
              <span class="diff-badge diff-${realLevel.toLowerCase()}">${realLevel} ${rText}</span>
            </div>
          </div>
        `;
      });
      html += `</div>`;
      app.innerHTML = html;
      window.scrollTo(0, 0);
    }

    // ==================== 谱师列表 ====================

    function getCharterData() {
      const charterMap = {};
      chapters.forEach(ch => {
        if (!ch.songs) return;
        ch.songs.forEach(song => {
          if (!song.difficulties) return;
          song.difficulties.forEach(d => {
            if (!d.charter) return;
            const rawName = d.charter.trim();
            const names = rawName.split(/&|vs\.|vs|,|，/).map(n => n.trim()).filter(n => n);
            const uniqueNames = [...new Set(names)];
            uniqueNames.forEach(name => {
              if (!charterMap[name]) charterMap[name] = [];
              const exists = charterMap[name].find(item => item.song.id === song.id && item.diff.level === d.level);
              if (!exists) charterMap[name].push({ song, chapter: ch, diff: d });
            });
          });
        });
      });
      return charterMap;
    }

    function showCharterList() {
      const charterMap = getCharterData();
      const charters = Object.keys(charterMap).map(name => ({
        name: name, count: charterMap[name].length
      })).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

      let html = `
        <a class="back-link" onclick="goHome()">← 返回主页</a>
        <h1 class="page-title">谱师列表</h1>
        <div class="chapter-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px;">
