      margin: 16px 0 8px 0;
      color: var(--accent);
      font-size: 13px;
      font-weight: bold;
      letter-spacing: 1px;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 6px;
    }

    #side-nav-content h4:first-child {
      margin-top: 0;
    }

    /* 侧边栏滚动条美化 */
    #side-nav-panel::-webkit-scrollbar {
      width: 4px;
    }

    #side-nav-panel::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
