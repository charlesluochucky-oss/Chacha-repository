<!DOCTYPE html>
<html lang="zh-CN">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phigros Wiki</title>
  <style>
    :root {
      --bg: #0d0d0f;
      --bg-elev: #16161a;
      --bg-card: #1c1c22;
      --border: #2a2a32;
      --text: #e8e8ec;
      --text-dim: #9a9aa5;
      --accent: #4ea1ff;
      --accent-soft: rgba(78, 161, 255, .12);
      --ez: #22c55e;
      --hd: #3b82f6;
      --in: #ef4444;
      --ly: #a855f7;
      --at: #f59e0b;
    }

    * {
      box-sizing: border-box
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);

      /* 👇 换成这行（优先调用本地更好看的现代黑体） 👇 */
      font-family: "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;

      line-height: 1.6;

      /* 👇 加上这两行，让黑底白字不再发虚、边缘更清晰 👇 */
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a {
      color: var(--accent);
      text-decoration: none
    }

    a:hover {
      text-decoration: underline
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(13, 13, 15, .85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border)
    }

    .navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px
    }

    .brand {
      font-weight: 700;
      font-size: 16px;
      color: var(--text);
      letter-spacing: .5px;
      cursor: pointer
    }

    .brand:hover {
      color: var(--accent);
      text-decoration: none
    }

    .nav-links {
      display: flex;
      gap: 4px;
      font-size: 14px;
      color: var(--text-dim)
    }

    .nav-item {
      position: relative
    }

    .nav-trigger {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 8px 12px;
      border-radius: 8px;
      color: var(--text-dim);
      cursor: pointer;
      user-select: none;
      transition: background .15s, color .15s
    }

    .nav-trigger:hover {
      background: var(--bg-elev);
      color: var(--text)
    }

    .nav-trigger .caret {
      font-size: 10px;
      opacity: .6;
      transition: transform .15s
    }

    .nav-item:hover .caret {
      transform: rotate(180deg)
    }

    .dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 160px;
      padding: 6px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .4);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition: opacity .15s, transform .15s, visibility .15s
    }

    .nav-item:hover .dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0)
    }

    .dropdown a {
      display: block;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 13.5px;
      color: var(--text-dim);
      white-space: nowrap;
      cursor: pointer
    }

    .dropdown a:hover {
      background: var(--accent-soft);
      color: var(--accent);
      text-decoration: none
    }

    main {
      padding: 40px 24px 80px;
      min-height: calc(100vh - 56px - 65px)
    }

    .home {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 140px 0
    }

    .home h1 {
      background: linear-gradient(90deg, var(--text) 0%, var(--accent) 50%, var(--text) 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      /* 👈 加这行，黄线就没了 */
      -webkit-text-fill-color: transparent;
      animation: shine 4s linear infinite, floatUp 3s ease-in-out infinite alternate;
    }

    .home .sub {
      font-size: 15px;
      color: var(--text-dim);
      margin: 0
    }

    .page-title {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 24px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border)
    }

    .back-link {
      display: inline-block;
      font-size: 13px;
      color: var(--text-dim);
      margin-bottom: 16px;
      cursor: pointer
    }

    .back-link:hover {
      color: var(--accent)
    }

    .chapter-list {
      display: flex;
      flex-direction: column;
      gap: 12px
    }

    .chapter-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 24px;
      cursor: pointer;
      transition: border-color .2s, transform .2s, background .2s
    }

    .chapter-row:hover {
      border-color: var(--accent);
      transform: translateX(4px);
      background: var(--bg-elev)
    }

    .chapter-left {
      flex-shrink: 0
    }

    .chapter-num {
      font-size: 12px;
      color: var(--text-dim);
      letter-spacing: 1px;
      margin-bottom: 4px
    }

    .chapter-name {
      font-size: 22px;
      font-weight: 700;
      color: var(--text)
    }

    .chapter-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
      font-size: 13px;
      color: var(--text-dim);
      justify-content: flex-end;
      text-align: right
    }

    .stat {
      display: inline-flex;
      align-items: baseline;
      gap: 4px;
      white-space: nowrap
    }

    .stat .k {
      color: var(--text-dim)
    }

    .stat .v {
      color: var(--text);
      font-weight: 600
    }

    .stat .v.ez {
      color: var(--ez)
    }

    .stat .v.hd {
      color: var(--hd)
    }

    .stat .v.in {
      color: var(--in)
    }

    .stat .v.at {
      color: var(--at)
    }

    .song-list {
      display: flex;
      flex-direction: column;
      gap: 12px
    }

    .song-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px 24px;
      color: var(--text);
      cursor: pointer;
      transition: border-color .2s, transform .2s, background .2s
    }

    .song-row:hover {
      text-decoration: none;
      border-color: var(--accent);
      transform: translateX(4px);
      background: var(--bg-elev)
    }

    .song-row-left {
      flex-shrink: 0
    }

    .song-row-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text)
    }

    .song-row-charter {
      font-size: 13px;
      color: var(--text-dim);
      margin-top: 2px
    }

    .song-row-diffs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: flex-end
    }

    .diff-badge {
      font-size: 12px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
      background: var(--bg-elev);
      border: 1px solid var(--border)
    }

    .diff-ez {
      color: var(--ez);
      border-color: var(--ez)
    }

    .diff-hd {
      color: var(--hd);
      border-color: var(--hd)
    }

    .diff-in {
      color: var(--in);
      border-color: var(--in)
    }

    .diff-ly {
      color: var(--ly);
      border-color: var(--ly)
    }

    .diff-at {
      color: var(--at);
      border-color: var(--at)
    }

    .song-detail {
      max-width: 900px
    }

    .song-detail-header {
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border)
    }

    .song-detail-header h2 {
      font-size: 32px;
      margin: 0 0 8px
    }

    .song-detail-header .artist {
      font-size: 15px;
      color: var(--text-dim);
      margin-bottom: 4px
    }

    .song-detail-header .illustrator {
      font-size: 13px;
      color: var(--text-dim)
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
      margin-bottom: 28px
    }

    .info-item {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      font-size: 13px
    }

    .info-item .k {
      color: var(--text-dim)
    }

    .info-item .v {
      font-weight: 600
    }

    table.diff-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-top: 8px
    }

    table.diff-table th,
    table.diff-table td {
      padding: 10px 12px;
      border: 1px solid var(--border);
      text-align: left;
      white-space: nowrap
    }

    table.diff-table th {
      background: var(--bg-elev);
      color: var(--text-dim);
      font-weight: 600
    }

    table.diff-table td.lv-EZ {
      color: var(--ez);
      font-weight: 700
    }

    table.diff-table td.lv-HD {
      color: var(--hd);
      font-weight: 700
    }

    table.diff-table td.lv-IN {
      color: var(--in);
      font-weight: 700
    }

    table.diff-table td.lv-LY {
      color: var(--ly);
      font-weight: 700
    }

    table.diff-table td.lv-AT {
      color: var(--at);
      font-weight: 700
    }

    .empty-hint {
      color: var(--text-dim);
      font-size: 14px;
      padding: 40px 0;
      text-align: center
    }

    .removed-note {
      margin-top: 24px;
      font-size: 13px;
      color: var(--text-dim);
      font-style: italic
    }

    .footer {
      border-top: 1px solid var(--border);
      padding: 24px 0;
      font-size: 13px;
      color: var(--text-dim);
      text-align: center
    }

    @media(max-width:720px) {
      .chapter-row {
        flex-direction: column;
        align-items: flex-start
      }

      .chapter-stats {
        justify-content: flex-start;
        text-align: left
      }

      .song-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px
      }

      .song-row-diffs {
        justify-content: flex-start
      }

      .home h1 {
        font-size: 32px
      }
    }

    /* 定数列表专属样式 */
    .rating-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }

    .rating-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: all .2s;
    }

    .rating-btn:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      background: var(--bg-elev);
    }

    /* B30 列表专属样式 */
    .b30-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }

    .b30-card {
      background: #16161a;
      /* 深色背景 */
      border: 2px solid #333;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 150px;
      /* 模拟一个全息/底图的质感 */
      background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, transparent 100%);
    }

    .b30-card:hover {
      border-color: var(--accent);
    }

    .b30-header {
      display: flex;
      justify-content: space-between;
      padding: 8px 12px;
      background: rgba(0, 0, 0, 0.5);
      font-size: 13px;
      font-weight: bold;
    }

    .b30-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #fff;
    }

    .b30-rank {
      color: #ccc;
      font-family: monospace;
      margin-left: 8px;
    }

    .b30-body {
      display: flex;
      align-items: center;
      padding: 12px;
      gap: 12px;
      flex-grow: 1;
      /* 模拟中间曲绘/特效区 */
      background: rgba(255, 255, 255, 0.02);
    }

    .b30-phi {
      font-size: 28px;
      color: #eab308;
      /* 金色 */
      font-weight: 900;
      font-family: sans-serif;
      text-shadow: 0 0 8px rgba(234, 179, 8, 0.5);
    }

    .b30-score {
      font-size: 18px;
      font-weight: bold;
      color: #fff;
      /* 👇 数字用等宽字体，绝对对齐 👇 */
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
    }

    .b30-score {
      font-size: 18px;
      font-weight: bold;
      color: #fff;
      font-family: monospace;
    }

    .b30-acc {
      font-size: 12px;
      color: #aaa;
      font-family: monospace;
    }

    .b30-footer {
      display: flex;
      justify-content: flex-end;
      padding: 8px 12px;
      background: rgba(0, 0, 0, 0.6);
    }

    .b30-level {
      font-size: 12px;
      font-weight: bold;
      padding: 2px 6px;
      border-radius: 4px;
      background: #333;
      color: #fff;
    }

    /* ==================== 终极丝滑动画引擎 (平滑慢速版) ==================== */

    /* 1. 全局平滑滚动 */
    html {
      scroll-behavior: smooth;
    }

    /* 2. 页面切换入场动画 (自上而下平滑浮现) */
    @keyframes pageEnter {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }

      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #app {
      /* 时间从 0.4s 延长到 0.8s，使用纯粹的超平滑缓出曲线，无回弹 */
      animation: pageEnter 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    /* 3. 主页动效 (呼吸光晕与文字柔和漂浮) */
    .home h1 {
      background: linear-gradient(90deg, var(--text) 0%, var(--accent) 50%, var(--text) 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      /* 浮动时间拉长到 5s，更加轻柔 */
      animation: shine 5s linear infinite, floatUp 5s ease-in-out infinite alternate;
    }

    @keyframes shine {
      to {
        background-position: 200% center;
      }
    }

    @keyframes floatUp {
      from {
        transform: translateY(0);
      }

      to {
        transform: translateY(-8px);
      }
    }

    /* 4. 列表级联入场动画 */
    @keyframes listEnter {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }

      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .anim-item {
      opacity: 0;
      /* 单项入场时间 0.8s，平滑缓出 */
      animation: listEnter 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
      /* 延迟从 0.03s 拉长到 0.06s，让瀑布流效果更从容 */
      animation-delay: calc(var(--i) * 0.06s);
    }

    /* 5. 章节卡片交互反馈 (平滑上浮，取消夸张的回弹) */
    .chapter-row {
      transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease !important;
    }

    .chapter-row:hover {
      transform: translateY(-6px) !important;
      border-color: var(--accent) !important;
      box-shadow: 0 12px 25px -10px rgba(78, 161, 255, 0.3);
    }

    .chapter-row:active {
      transform: translateY(-2px) !important;
    }

    /* 6. 曲目列表行交互反馈 */
    .song-row {
      transition: transform 0.4s ease, border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease !important;
    }

    .song-row:hover {
      transform: translateY(-4px) !important;
      border-color: var(--accent) !important;
      background: linear-gradient(90deg, var(--bg-elev) 0%, rgba(78, 161, 255, 0.05) 100%) !important;
      box-shadow: 0 8px 20px -8px rgba(78, 161, 255, 0.2);
    }

    .song-row:active {
      transform: translateY(0) !important;
    }

    /* 7. 返回按钮的幽灵滑动 (放慢) */
    .back-link {
      transition: all 0.4s ease;
    }

    .back-link:hover {
      transform: translateX(-6px);
      color: var(--accent);
    }

    /* 8. 定数按钮点击波纹 (平滑上浮，取消缩放回弹) */
    .rating-btn {
      transition: all 0.4s ease;
    }

    .rating-btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px -10px var(--accent);
    }

    .rating-btn:active {
      transform: translateY(-1px);
    }

    /* 9. B30 卡片平滑浮现 (取消 3D 翻转，改为柔和平移) */
    @keyframes cardPop {
      0% {
        opacity: 0;
        transform: translateY(40px) scale(0.98);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .b30-card {
      transition: transform 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease !important;
      animation: cardPop 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
      opacity: 0;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .b30-card:hover {
      transform: translateY(-8px) !important;
      border-color: var(--accent) !important;
      box-shadow: 0 20px 40px -15px rgba(78, 161, 255, 0.4);
      z-index: 10;
    }

    /* B30 里的 φ 符号呼吸浮动 (更缓慢) */
    @keyframes phiPulse {

      0%,
      100% {
        transform: scale(1);
        text-shadow: 0 0 8px rgba(234, 179, 8, 0.5);
      }

      50% {
        transform: scale(1.08);
        text-shadow: 0 0 20px rgba(234, 179, 8, 0.8);
      }
    }

    .b30-card:hover .b30-phi {
      animation: phiPulse 3s infinite ease-in-out;
    }

    /* ==================== 1.0.1 补丁样式 ==================== */

    /* 双栏布局：曲目详情页 */
    .song-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    @media (min-width: 900px) {
      .song-layout {
        grid-template-columns: 1fr 320px;
        /* 左侧自适应，右侧固定 320px */
      }
    }

    /* 左侧主区域重置最大宽度，交给网格控制 */
    .song-main {
      max-width: 100%;
    }

    /* 右侧悬浮卡片 */
    .song-sidebar {
      position: sticky;
      top: 80px;
      /* 导航栏高度 + 边距 */
    }

    .side-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .side-card h3 {
      margin: 0 0 16px 0;
      font-size: 16px;
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
    }

    .total-notes {
      font-size: 32px;
      font-weight: 800;
      color: var(--accent);
      margin-bottom: 20px;
      line-height: 1;
    }

    .total-notes span {
      font-size: 14px;
      color: var(--text-dim);
      font-weight: normal;
    }

    /* 物量占比进度条 */
    .note-bar-item {
      margin-bottom: 12px;
    }

    .bar-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--text-dim);
      margin-bottom: 4px;
    }

    .bar-bg {
      width: 100%;
      height: 6px;
      background: var(--bg-elev);
      border-radius: 3px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 1s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* 猜曲界面 */
    .guess-container {
      max-width: 600px;
      margin: 0 auto;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .guess-hints {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 32px;
      text-align: left;
    }

    .guess-item {
      background: var(--bg-elev);
      padding: 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
    }

    .guess-item .k {
      font-size: 12px;
      color: var(--text-dim);
      margin-bottom: 4px;
    }

    .guess-item .v {
      font-size: 16px;
      font-weight: bold;
      color: var(--accent);
    }

    .guess-input-area {
      display: flex;
      gap: 12px;
    }

    #guess-input {
      flex-grow: 1;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 16px;
      outline: none;
      transition: border 0.3s;
    }

    #guess-input:focus {
      border-color: var(--accent);
    }

    .guess-input-area button {
      padding: 12px 24px;
      border-radius: 8px;
      border: none;
      background: var(--accent);
      color: #fff;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.3s;
    }

    .guess-input-area button:hover {
      background: #3b82f6;
    }

    .guess-result {
      margin-top: 24px;
      font-size: 18px;
      min-height: 30px;
    }

    /* ==================== 1.0.1 新增模块样式 ==================== */
    .text-up {
      color: #ef4444;
      font-weight: bold;
      font-size: 14px;
      margin-left: 8px;
    }

    .text-down {
      color: #22c55e;
      font-weight: bold;
      font-size: 14px;
      margin-left: 8px;
    }

    .change-row {
      display: flex;
      align-items: center;
      padding: 16px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 12px;
    }

    .change-date {
      width: 120px;
      color: var(--text-dim);
      font-size: 14px;
    }

    .change-song {
      flex-grow: 1;
      font-size: 16px;
    }

    .change-rating {
      font-family: monospace;
      font-size: 16px;
      font-weight: bold;
    }

    .puzzle-display {
      font-size: 32px;
      font-weight: 900;
      color: var(--accent);
      letter-spacing: 4px;
      background: var(--bg-elev);
      padding: 24px;
      border-radius: 12px;
      border: 1px dashed var(--accent);
    }

    .changelog-container {
      display: flex;
      flex-direction: column;
      gap: 24px;
      max-width: 800px;
    }

    .log-card {
      background: var(--bg-card);
      padding: 24px;
      border-radius: 12px;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
    }

    .log-card h3 {
      margin: 0 0 16px 0;
      font-size: 20px;
    }

    .log-card ul {
      margin: 0;
      padding-left: 20px;
      color: var(--text-dim);
      line-height: 1.8;
    }

    .log-card ul strong {
      color: var(--text);
    }

    /* ==================== 1.0.4 宽屏流式布局 ==================== */

    /* 1. 曲目详情页占满宽屏 */
    .song-detail {
      width: 100%;
      max-width: 1200px;
      /* 限制一个最大宽度，防止带鱼屏太散 */
      margin: 0 auto;
    }

    .song-main {
      width: 100%;
    }

    /* 2. 表格容器 (超宽自适应) */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      margin-bottom: 24px;
      /* 给下方物量分析留出空隙 */
    }

    /* 3. 表格本身 */
    table.diff-table {
      width: 100%;
      min-width: 800px;
      /* 小屏幕下横向滚动，大屏幕下占满 */
      border-collapse: collapse;
      font-size: 14px;
    }

    table.diff-table th,
    table.diff-table td {
      padding: 14px 12px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    table.diff-table th:nth-child(4),
    table.diff-table td:nth-child(4),
    table.diff-table th:nth-child(5),
    table.diff-table td:nth-child(5) {
      text-align: left;
    }

    table.diff-table th {
      background: var(--bg-elev);
      color: var(--text-dim);
      font-weight: 600;
    }

    table.diff-table tbody tr:nth-child(even) {
      background: rgba(255, 255, 255, 0.02);
    }

    table.diff-table tbody tr:hover {
      background: rgba(78, 161, 255, 0.08);
    }

    table.diff-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* 4. 下方横向物量分析卡片 */
    .side-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 24px;
      width: 100%;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .side-card h3 {
      margin: 0 0 16px 0;
      font-size: 16px;
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
    }

    /* Tabs 难度选择 (左对齐，紧凑) */
    .diff-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .diff-tab {
      padding: 8px 20px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 8px;
      color: var(--text-dim);
      background: var(--bg-elev);
      border: 1px solid transparent;
      transition: all 0.2s;
    }

    .diff-tab:hover {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text);
    }

    .diff-tab.active {
      background: rgba(78, 161, 255, 0.1);
      color: var(--accent);
      border-color: var(--accent);
    }

    .diff-tab.active[data-level="EZ"] {
      color: var(--ez);
      border-color: var(--ez);
      background: rgba(34, 197, 94, 0.1);
    }

    .diff-tab.active[data-level="HD"] {
      color: var(--hd);
      border-color: var(--hd);
      background: rgba(59, 130, 246, 0.1);
    }

    .diff-tab.active[data-level="IN"] {
      color: var(--in);
      border-color: var(--in);
      background: rgba(239, 68, 68, 0.1);
    }

    .diff-tab.active[data-level="AT"] {
      color: var(--at);
      border-color: var(--at);
      background: rgba(245, 158, 11, 0.1);
    }

    .diff-tab.active[data-level="LY"] {
      color: var(--ly);
      border-color: var(--ly);
      background: rgba(168, 85, 247, 0.1);
    }

    .diff-tab.active[data-level="SP"] {
      color: #fff;
      border-color: #fff;
      background: rgba(255, 255, 255, 0.1);
    }

    .tab-content {
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(5px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* 物量数据横向排版 */
    .total-notes {
      font-size: 32px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 20px;
    }

    .total-notes span {
      font-size: 14px;
      color: var(--text-dim);
      font-weight: normal;
      margin-left: 8px;
    }

    .note-bars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }

    .note-bar-item {
      width: 100%;
    }

    .bar-label {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--text-dim);
      margin-bottom: 8px;
      font-weight: bold;
    }

    .bar-bg {
      width: 100%;
      height: 8px;
      background: var(--bg-elev);
      border-radius: 4px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* ==================== 定数变更页样式 ==================== */
    .change-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      /* 稍微加宽卡片以容纳四列 */
      gap: 20px;
      margin-top: 20px;
    }

    .change-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
    }

    .change-card-header {
      text-align: center;
      font-weight: bold;
      padding: 12px 10px;
      font-size: 15px;
      color: var(--text);
      background: var(--bg-elev);
      border-bottom: 1px solid var(--border);
      border-radius: 12px 12px 0 0;
    }

    .change-card-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    /* 核心布局：四列并排 */
    .change-cols {
      display: flex;
      justify-content: space-between;
      /* 自动均分间距 */
      align-items: flex-start;
      gap: 10px;
    }

    .change-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .change-level {
      font-size: 12px;
      font-weight: bold;
      padding: 2px 8px;
      border-radius: 4px;
      background: #333;
      color: #fff;
      margin-bottom: 12px;
      width: max-content;
    }

    .change-level.diff-ez {
      background: var(--ez);
      color: #fff;
    }

    .change-level.diff-hd {
      background: var(--hd);
      color: #fff;
    }

    .change-level.diff-in {
      background: var(--in);
      color: #fff;
    }

    .change-level.diff-at {
      background: var(--at);
      color: #fff;
    }

    .change-level.diff-ly {
      background: var(--ly);
      color: #fff;
    }

    .change-history {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .change-val {
      font-size: 14px;
      color: var(--text);
      font-family: monospace;
      font-weight: bold;
    }

    .change-arrow {
      color: var(--text-dim);
      font-size: 12px;
      line-height: 1;
    }

    .change-delta {
      font-size: 12px;
      font-family: monospace;
      font-weight: bold;
      margin: 2px 0;
    }

    /* 变化量颜色 */
    .text-up {
      color: #ef4444;
    }

    /* 红色：上升 */
    .text-down {
      color: #22c55e;
    }

    /* 绿色：下降 */
    .text-zero {
      color: var(--text-dim);
    }

    .diff-all {
      color: var(--accent);
      border-color: var(--accent);
    }

    /* ==================== 三级导航菜单专属样式 ==================== */
    .sub-nav-item {
      position: relative;
    }

    .sub-nav-trigger {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 13.5px;
      color: var(--text-dim);
      white-space: nowrap;
      cursor: pointer;
      transition: background .15s, color .15s;
    }

    .sub-nav-trigger:hover {
      background: var(--accent-soft);
      color: var(--accent);
    }

    .sub-dropdown {
      position: absolute;
      top: 0;
      left: 100%;
      min-width: 120px;
      padding: 6px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .4);
      opacity: 0;
      visibility: hidden;
      transform: translateX(-4px);
      transition: opacity .15s, transform .15s, visibility .15s;
    }

    /* 鼠标悬停在二级菜单时，展开三级菜单 */
    .sub-nav-item:hover .sub-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
    }

    .sub-dropdown a {
      display: block;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 13.5px;
      color: var(--text-dim);
      white-space: nowrap;
      cursor: pointer;
    }

    .sub-dropdown a:hover {
      background: var(--accent-soft);
      color: var(--accent);
      text-decoration: none;
    }

    /* ==================== PMT 赛况及排名样式 ==================== */
    .pmt-rank-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 800px;
      margin: 0 auto;
    }

    .pmt-rank-item {
      display: flex;
      align-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 24px;
      transition: transform 0.2s, background 0.2s;
    }

    .pmt-rank-item:hover {
      background: var(--bg-elev);
      transform: translateX(4px);
    }

    .pmt-rank-num {
      font-size: 20px;
      font-weight: 900;
      font-family: monospace;
      width: 60px;
      flex-shrink: 0;
    }

    .rank-top3 {
      color: #eab308;
      text-shadow: 0 0 10px rgba(234, 179, 8, 0.4);
    }

    .rank-top8 {
      color: #ef4444;
    }

    .rank-top16 {
      color: #3b82f6;
    }

    .rank-normal {
      color: var(--text-dim);
    }

    .pmt-rank-info {
      flex-grow: 1;
    }

    .pmt-rank-name {
      font-size: 16px;
      font-weight: bold;
      color: var(--text);
    }

    .pmt-rank-id {
      font-size: 12px;
      color: var(--text-dim);
      margin-top: 2px;
    }

    .pmt-rank-score {
      font-size: 18px;
      font-weight: bold;
      color: var(--accent);
      font-family: monospace;
    }

    /* 赛况卡片 */
    .pmt-bracket-container {
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: 1000px;
      margin: 0 auto;
    }

    .pmt-round-title {
      font-size: 22px;
      color: var(--accent);
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
      margin-top: 24px;
    }

    .pmt-match-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .pmt-match-header {
      background: var(--bg-elev);
      padding: 12px 20px;
      font-weight: bold;
      color: var(--text);
      border-bottom: 1px solid var(--border);
    }

    .pmt-match-body {
      display: flex;
      flex-direction: column;
    }

    .pmt-match-players {
      display: flex;
      flex-direction: column;
      padding: 16px 20px;
      gap: 12px;
      border-bottom: 1px solid var(--border);
    }

    .pmt-player-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-elev);
      padding: 12px 16px;
      border-radius: 8px;
    }

    .pmt-p-info {
      display: flex;
      flex-direction: column;
    }

    .pmt-p-name {
      font-weight: bold;
      font-size: 16px;
      color: var(--text);
    }

    .pmt-p-id {
      font-size: 12px;
      color: var(--text-dim);
    }

    .pmt-p-stats {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .pmt-p-score {
      font-family: monospace;
      font-weight: bold;
      font-size: 18px;
      color: var(--text);
    }

    .pmt-p-status {
      font-size: 12px;
      font-weight: bold;
      padding: 4px 10px;
      border-radius: 6px;
    }

    .status-win {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }

    .status-lose {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
    }

    /* 谱面表格 */
    .pmt-match-charts {
      padding: 16px 20px;
      overflow-x: auto;
    }

    .pmt-chart-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: center;
    }

    .pmt-chart-table th,
    .pmt-chart-table td {
      padding: 8px 12px;
      border: 1px solid var(--border);
    }

    .pmt-chart-table th {
      background: var(--bg-elev);
      color: var(--text-dim);
      font-weight: 600;
    }

    .pmt-chart-table td:first-child {
      text-align: left;
      color: var(--text);
      font-weight: bold;
    }

    .pmt-chart-table tbody tr:nth-child(even) {
      background: rgba(255, 255, 255, 0.02);
    }

    /* ==================== 侧边悬浮导航 ==================== */
    #side-nav-trigger {
      position: fixed;
      top: 80px;
      /* 避开顶部导航栏 */
      left: 10px;
      width: 30px;
      height: 50px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: none;
      border-radius: 0 8px 8px 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 100;
      color: var(--text-dim);
      font-size: 12px;
      transition: transform 0.3s, background 0.3s;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.5);
    }

    #side-nav-trigger:hover {
      background: var(--bg-elev);
      color: var(--accent);
    }

    /* 展开时箭头旋转 */
    #side-nav-trigger.open {
      transform: rotate(180deg);
      left: 200px;
      /* 跟随面板宽度移动 */
    }

    #side-nav-panel {
      position: fixed;
      top: 80px;
      left: -220px;
      /* 默认隐藏 */
      width: 200px;
      max-height: calc(100vh - 100px);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 0 12px 12px 0;
      z-index: 99;
      transition: left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    /* 展开状态 */
    #side-nav-panel.open {
      left: 0;
    }

    #side-nav-content {
      padding: 16px;
    }

    #side-nav-content h4 {
      margin: 0 0 12px 0;
      color: var(--accent);
      font-size: 14px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
    }

    #side-nav-content a {
      display: block;
      padding: 10px 12px;
      color: var(--text-dim);
      font-size: 13px;
      border-radius: 6px;
      cursor: pointer;
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #side-nav-content a:hover {
      background: var(--accent-soft);
      color: var(--accent);
    }

    /* 侧边栏分组标题样式优化 */
